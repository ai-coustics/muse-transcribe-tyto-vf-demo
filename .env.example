# Muse Voice Transcribe via the Meta Model API.
# Create a key in the Model API dashboard at https://dev.meta.ai
MODEL_API_KEY=your-meta-model-api-key

# Optional: point at a different deployment or a self-hosted server.
# The live path derives its wss:// URL from MUSE_API_BASE.
# MUSE_API_BASE=https://api.meta.ai/v1
# MUSE_MODEL=muse-voice-transcribe-1.0

# Create this key at https://developers.ai-coustics.com
AIC_SDK_LICENSE=your-ai-coustics-sdk-license

# Abuse limits (0 disables any one of them)
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_DAILY=200
# How long comparison audio stays in memory for A/B playback
AUDIO_TTL_SECONDS=600
